# Salin file ini menjadi .env.local, lalu sesuaikan kredensial MySQL MAMP Anda.
DATABASE_URL=mysql://root:@127.0.0.1:3306/healthair_local
JWT_SECRET=ganti-dengan-rangkaian-acak-panjang-minimal-32-karakter
VITE_APP_ID=healthair-local
PORT=3000
# Buat kunci di https://platform.openai.com/api-keys dan simpan hanya di server.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:alerts@example.com
